{
  "name": "discord-management-bot",
  "version": "1.0.0",
  "description": "A professional Discord management bot for a Roblox roleplay community.",
  "main": "index.js",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "start": "node index.js",
    "build": "npm run typecheck && npm run check:banner-quality && npm run check:v2-emblems",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --transpile-only tests/smoke.ts",
    "check:banner-quality": "node scripts/check-banner-quality.js",
    "check:v2-emblems": "node scripts/check-v2-emblems.js",
    "check": "npm run typecheck && npm run check:banner-quality && npm test",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "dependencies": {
    "discord.js": "^14.0.0",
    "dotenv": "^10.0.0",
    "mongoose": "^6.0.0",
    "sharp": "^0.35.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node-dev": "^2.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "management",
    "roblox",
    "roleplay"
  ],
  "author": "California State Roleplay",
  "license": "MIT"
}
