{
  "name": "discord-management-bot",
  "version": "1.0.0",
  "description": "A professional Discord management bot for a Roblox roleplay community.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "node -e \"console.log('No compile step required; index.js uses ts-node transpileOnly at runtime.')\"",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --transpile-only tests/smoke.ts",
    "check": "npm run typecheck && npm test",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "dependencies": {
    "discord.js": "^14.0.0",
    "dotenv": "^10.0.0",
    "mongoose": "^6.0.0",
    "sharp": "^0.35.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node-dev": "^2.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "management",
    "roblox",
    "roleplay"
  ],
  "author": "California State Roleplay",
  "license": "MIT"
}
