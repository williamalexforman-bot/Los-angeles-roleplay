{
  "name": "discord-management-bot",
  "version": "1.0.0",
  "description": "A professional Discord management bot for a Roblox roleplay community.",
  "main": "dist/index.js",
  "scripts": {
    "start": "node .",
    "build": "tsc",
    "postinstall": "npm run build",
    "test": "ts-node --transpile-only tests/smoke.ts",
    "check": "npm run build && npm test",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "dependencies": {
    "@githubnext/github-copilot-cli": "^0.1.36",
    "discord.js": "^14.0.0",
    "dotenv": "^10.0.0",
    "mongoose": "^6.0.0"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.0",
    "@types/mongoose": "^5.10.0",
    "@types/node": "^20.0.0",
    "pm2": "^7.0.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "discord",
    "bot",
    "management",
    "roblox",
    "roleplay"
  ],
  "author": "California State Roleplay",
  "license": "MIT"
}
