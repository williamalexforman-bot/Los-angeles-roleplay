# =============================================
# Discord Bot - Required Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# For WisbyCloud: add these under Environment Variables in your dashboard.
# =============================================

# === REQUIRED: Discord Bot Token ===
# Get this from https://discord.com/developers/applications
BOT_TOKEN=your_discord_bot_token_here

# === REQUIRED: MongoDB Connection String ===
# Get a free database at https://mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# === RECOMMENDED: Discord Server (Guild) ID ===
GUILD_ID=your_discord_server_id

# === OPTIONAL: Discord Channel IDs ===
LOG_CHANNEL_ID=
APPLICATION_CHANNEL_ID=
TRAINING_CHANNEL_ID=
INFRACTION_CHANNEL_ID=
PROMOTION_CHANNEL_ID=
JOIN_LOG_CHANNEL_ID=
LEAVE_LOG_CHANNEL_ID=
DISCORD_KICK_LOG_CHANNEL_ID=
DISCORD_BAN_LOG_CHANNEL_ID=
RAID_THREAT_LOG_CHANNEL_ID=

# === Server Security Guard ===
# Enabled by default. New bots, webhooks, and integrations are denied unless
# their executor is the server owner, this bot, or is explicitly trusted below.
SECURITY_PROTECTION_ENABLED=true
SECURITY_LOG_CHANNEL_ID=
SECURITY_ALERT_ROLE_ID=
SECURITY_TRUSTED_USER_IDS=
SECURITY_TRUSTED_ROLE_IDS=
SECURITY_ALLOWED_BOT_IDS=
SECURITY_ALLOWED_WEBHOOK_IDS=
SECURITY_ALLOWED_INTEGRATION_IDS=
# "ban" prevents an unauthorized bot from being re-added; set to "kick" if preferred.
SECURITY_UNAUTHORIZED_BOT_ACTION=ban

# High-confidence targeted bullying is deleted and timed out automatically.
BULLYING_TIMEOUT_MINUTES=10

# === OPTIONAL: Discord Role IDs ===
ADMIN_ROLE_ID=
SUPPORT_ROLE_ID=
HIGH_RANK_ROLE_ID=
GENERAL_SUPPORT_ROLE_ID=
MANAGEMENT_ROLE_ID=
INTERNAL_AFFAIRS_ROLE_ID=
BOT_PERMISSIONS_ROLE_ID=
EMERGENCY_STAFF_ROLE_ID=

# Roles that can approve/deny LOA requests (comma-separated, in addition to Administrator)
LOA_MANAGEMENT_ROLE_IDS=

# === OPTIONAL: API Keys ===
# Dock verification key. Keep the real value in your hosting provider's secret/environment settings.
DOCK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
ERLC_SERVER_KEY=

# === Marketplace Roblox Purchase Verification ===
# Fill these in when your Roblox paid-ad items are ready.
# Item type defaults to gamepass. Change only if your configured Roblox item uses a different inventory item type.
MARKETPLACE_PAID_AD_EVERYONE_ITEM_ID=
MARKETPLACE_PAID_AD_EVERYONE_ITEM_TYPE=gamepass
MARKETPLACE_PAID_AD_HERE_ITEM_ID=
MARKETPLACE_PAID_AD_HERE_ITEM_TYPE=gamepass

# === OPTIONAL: Bot Configuration ===
ENABLE_PRIVILEGED_INTENTS=true
ERLC_POLL_INTERVAL_MS=30000
DISABLE_ERLC_MONITOR=false
INFRACTION_AUTHORIZED_USER_IDS=
INFRACTION_AUTHORIZED_ROLE_IDS=
PREFIX=/
