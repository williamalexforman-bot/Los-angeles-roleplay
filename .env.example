# =============================================
# Los Angeles Roleplay Discord Bot
# Render Environment Variable Template
# =============================================
# IMPORTANT:
# - Do NOT commit a real .env file.
# - Put real secrets in Render -> Environment.
# - This file contains names/examples only.
# =============================================

# === REQUIRED: Discord ===
BOT_TOKEN=your_discord_bot_token_here
GUILD_ID=1521593407741362257
ENABLE_PRIVILEGED_INTENTS=true

# === REQUIRED: MongoDB Atlas ===
# Preferred Render-safe setup: use all three split values below.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_HOST=
MONGODB_DATABASE=discordbot

# Optional backwards-compatible fallback. Leave blank when the split MongoDB
# variables above are configured.
MONGODB_URI=

# === Render / runtime ===
NODE_ENV=production
NODE_VERSION=22.22.0
PORT=10000
# RENDER_EXTERNAL_URL and RENDER_EXTERNAL_HOSTNAME are supplied automatically
# by Render. Do not hardcode them unless you have a specific reason.

# === AI ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
TICKET_RECAP_MODEL=gpt-5-mini

# === ER:LC / external integrations ===
ERLC_SERVER_KEY=
ERLC_POLL_INTERVAL_MS=30000
DISABLE_ERLC_MONITOR=false
DOCK_API_KEY=
BLOXLINK_API_KEY=
MELONY_API_KEY=
MELONY_API_URL=
INGAME_API_URL=

# === Marketplace Roblox Purchase Verification ===
MARKETPLACE_PAID_AD_EVERYONE_ITEM_ID=
MARKETPLACE_PAID_AD_EVERYONE_ITEM_TYPE=gamepass
MARKETPLACE_PAID_AD_HERE_ITEM_ID=
MARKETPLACE_PAID_AD_HERE_ITEM_TYPE=gamepass

# === Core Discord channels ===
LOG_CHANNEL_ID=
APPLICATION_CHANNEL_ID=
TRAINING_CHANNEL_ID=
INFRACTION_CHANNEL_ID=
PROMOTION_CHANNEL_ID=
JOIN_LOG_CHANNEL_ID=
LEAVE_LOG_CHANNEL_ID=
DISCORD_KICK_LOG_CHANNEL_ID=
DISCORD_BAN_LOG_CHANNEL_ID=
RAID_THREAT_LOG_CHANNEL_ID=
PROFANITY_LOG_CHANNEL_ID=
ERLC_COMMAND_LOG_CHANNEL_ID=
DISCORD_COMMAND_LOG_CHANNEL_ID=
ERLC_TEAM_CHANGE_LOG_CHANNEL_ID=
ERLC_PUNISHMENT_LOG_CHANNEL_ID=
SESSION_ANNOUNCEMENT_CHANNEL_ID=
TRAINING_RESULTS_CHANNEL_ID=
INFRACTION_PARENT_CHANNEL_ID=
STAFF_FEEDBACK_CHANNEL_ID=
PARTNERSHIP_REQUEST_CHANNEL_ID=
STAFF_COMPLAINT_CHANNEL_ID=
PRIVATE_AUDIT_LOG_CHANNEL_ID=
CSRP_RULES_CHANNEL_ID=
PAID_PARTNER_CHANNEL_ID=

# === Server Security Guard ===
# Enabled by default. New bots, webhooks, and integrations are denied unless
# their executor is the server owner, this bot, or is explicitly trusted below.
SECURITY_PROTECTION_ENABLED=true
SECURITY_LOG_CHANNEL_ID=
SECURITY_ALERT_ROLE_ID=
SECURITY_TRUSTED_USER_IDS=
SECURITY_TRUSTED_ROLE_IDS=
SECURITY_ALLOWED_BOT_IDS=
SECURITY_ALLOWED_WEBHOOK_IDS=
SECURITY_ALLOWED_INTEGRATION_IDS=
# "ban" prevents an unauthorized bot from being re-added; set to "kick" if preferred.
SECURITY_UNAUTHORIZED_BOT_ACTION=ban

# High-confidence targeted bullying is deleted and timed out automatically.
BULLYING_TIMEOUT_MINUTES=10

# === Discord roles ===
ADMIN_ROLE_ID=
SUPPORT_ROLE_ID=
HIGH_RANK_ROLE_ID=
GENERAL_SUPPORT_ROLE_ID=
MANAGEMENT_ROLE_ID=
INTERNAL_AFFAIRS_ROLE_ID=
BOT_PERMISSIONS_ROLE_ID=
EMERGENCY_STAFF_ROLE_ID=
PARTNERSHIP_ROLE_ID=
LOA_MANAGEMENT_ROLE_IDS=
QUOTA_MOD_ROLE_ID=1521593407795888336

# === Moderation / command config ===
INFRACTION_AUTHORIZED_USER_IDS=
INFRACTION_AUTHORIZED_ROLE_IDS=
PREFIX=/
