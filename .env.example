# ──────────────────────────────────────────────────────────────────────────────
# California State Roleplay — Discord Management Bot
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

## REQUIRED ─ Discord Bot Token (get from https://discord.com/developers/applications)
BOT_TOKEN=your_discord_bot_token_here

## REQUIRED ─ MongoDB Connection String (get from https://mongodb.com — free tier works)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/csrp-bot?retryWrites=true&w=majority

## OPTIONAL ─ Privileged Intents (enable in Discord Developer Portal first)
ENABLE_PRIVILEGED_INTENTS=true

## OPTIONAL ─ Discord Server ID
GUILD_ID=your_guild_id_here

## ── Channel & Role IDs ──────────────────────────────────────────────────────
LOG_CHANNEL_ID=1529283685168447698
SUPPORT_ROLE_ID=
ADMIN_ROLE_ID=
HIGH_RANK_ROLE_ID=
GENERAL_SUPPORT_ROLE_ID=
MANAGEMENT_ROLE_ID=
INTERNAL_AFFAIRS_ROLE_ID=
TICKET_CHANNEL_ID=
APPLICATION_CHANNEL_ID=
TRAINING_CHANNEL_ID=
INFRACTION_CHANNEL_ID=
PROMOTION_CHANNEL_ID=
BOT_PERMISSIONS_ROLE_ID=
EMERGENCY_STAFF_ROLE_ID=
JOIN_LOG_CHANNEL_ID=
LEAVE_LOG_CHANNEL_ID=
DISCORD_KICK_LOG_CHANNEL_ID=
DISCORD_BAN_LOG_CHANNEL_ID=

## ── Integrations ────────────────────────────────────────────────────────────
BLOXLINK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
ERLC_SERVER_KEY=

## ── Webhook ─────────────────────────────────────────────────────────────────
WEBHOOK_PORT=3000
WEBHOOK_SECRET=

## ── Partnership Approval ────────────────────────────────────────────────────
PARTNERSHIP_APPROVAL_CHANNEL_ID=1526042350802043022
PARTNERSHIP_ROLE_ID=
PARTNERSHIP_REQUEST_CHANNEL_ID=
STAFF_COMPLAINT_CHANNEL_ID=

## ── Ticket Settings ─────────────────────────────────────────────────────────
TICKET_PENDING_TTL_MS=900000

## ── Infraction Authorization ────────────────────────────────────────────────
INFRACTION_AUTHORIZED_USER_IDS=
INFRACTION_AUTHORIZED_ROLE_IDS=

## ── ER:LC Monitor ───────────────────────────────────────────────────────────
ERLC_POLL_INTERVAL_MS=30000

## ── Prefix (legacy commands) ────────────────────────────────────────────────
PREFIX=/

