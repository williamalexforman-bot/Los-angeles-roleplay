# =============================================
# Discord Bot - Required Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# For WisbyCloud: add these under Environment Variables in your dashboard.
# =============================================

# === REQUIRED: Discord Bot Token ===
# Get this from https://discord.com/developers/applications
BOT_TOKEN=your_discord_bot_token_here

# === REQUIRED: MongoDB Connection String ===
# Get a free database at https://mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# === RECOMMENDED: Discord Server (Guild) ID ===
GUILD_ID=your_discord_server_id

# === OPTIONAL: Discord Channel IDs ===
LOG_CHANNEL_ID=
TICKET_CHANNEL_ID=
APPLICATION_CHANNEL_ID=
TRAINING_CHANNEL_ID=
INFRACTION_CHANNEL_ID=
PROMOTION_CHANNEL_ID=
JOIN_LOG_CHANNEL_ID=
DASHBOARD_URL=
LEAVE_LOG_CHANNEL_ID=
DISCORD_KICK_LOG_CHANNEL_ID=
DISCORD_BAN_LOG_CHANNEL_ID=
RAID_THREAT_LOG_CHANNEL_ID=
TICKET_PANEL_CHANNEL_ID=
TICKET_TRANSCRIPT_CHANNEL_ID=
CSRP_RULES_CHANNEL_ID=
PAID_PARTNER_CHANNEL_ID=
PROFANITY_LOG_CHANNEL_ID=
ERLC_COMMAND_LOG_CHANNEL_ID=
DISCORD_COMMAND_LOG_CHANNEL_ID=
ERLC_TEAM_CHANGE_LOG_CHANNEL_ID=
ERLC_PUNISHMENT_LOG_CHANNEL_ID=
TRAINING_RESULTS_CHANNEL_ID=
INFRACTION_PARENT_CHANNEL_ID=
STAFF_FEEDBACK_CHANNEL_ID=
MOVIE_FEEDBACK_CHANNEL_ID=
PARTNERSHIP_APPROVAL_CHANNEL_ID=
PARTNERSHIP_REQUEST_CHANNEL_ID=
STAFF_COMPLAINT_CHANNEL_ID=
PRIVATE_AUDIT_LOG_CHANNEL_ID=
AUDIT_LOG_CHANNEL_ID=

# === OPTIONAL: Discord Role IDs ===
ADMIN_ROLE_ID=
SUPPORT_ROLE_ID=
HIGH_RANK_ROLE_ID=
GENERAL_SUPPORT_ROLE_ID=
MANAGEMENT_ROLE_ID=
INTERNAL_AFFAIRS_ROLE_ID=
BOT_PERMISSIONS_ROLE_ID=
EMERGENCY_STAFF_ROLE_ID=
PARTNERSHIP_ROLE_ID=

# === OPTIONAL: Ticket Category IDs ===
GENERAL_SUPPORT_CATEGORY_ID=
INTERNAL_AFFAIRS_CATEGORY_ID=
MANAGEMENT_CATEGORY_ID=
HIGH_RANK_CATEGORY_ID=

# === OPTIONAL: API Keys ===
BLOXLINK_API_KEY=
ERLC_SERVER_KEY=
# Render may use this alias instead. Configure either variable, not both.
ERLC_API=

# === OPTIONAL: Bot Configuration ===
# Defaults to true. Set false only if privileged intents are unavailable in the Developer Portal.
ENABLE_PRIVILEGED_INTENTS=true
ERLC_POLL_INTERVAL_MS=30000
DISABLE_ERLC_MONITOR=false
INFRACTION_AUTHORIZED_USER_IDS=
INFRACTION_AUTHORIZED_ROLE_IDS=
PREFIX=/
PORT=3000
WEBHOOK_PORT=3000
WEBHOOK_SECRET=
TICKET_PENDING_TTL_MS=300000
